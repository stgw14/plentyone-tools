		{
			"name": "Authentication",
			"item": [
				{
					"name": "Login",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"// Save tokens to environment after successful login",
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    if (response.accessToken) {",
									"        pm.environment.set('accessToken', response.accessToken);",
									"        console.log('Access token saved to environment');",
									"    }",
									"    if (response.refreshToken) {",
									"        pm.environment.set('refreshToken', response.refreshToken);",
									"        console.log('Refresh token saved to environment');",
									"    }",
									"    if (response.tokenType) {",
									"        pm.environment.set('tokenType', response.tokenType);",
									"    }",
									"    pm.test('Login successful', function() {",
									"        pm.expect(response.accessToken).to.not.be.undefined;",
									"    });",
									"} else {",
									"    pm.test('Login failed', function() {",
									"        pm.expect.fail('Login returned status ' + pm.response.code);",
									"    });",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Content-Type",
								"value": "application/json"
							},
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"body": {
							"mode": "raw",
							"raw": "{\n  \"username\": \"{{username}}\",\n  \"password\": \"{{password}}\"\n}"
						},
						"url": {
							"raw": "{{baseUrl}}/rest/login",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"rest",
								"login"
							]
						},
						"description": "Authenticates a user and returns access token. Tokens are automatically saved to environment variables."
					},
					"response": []
				},
				{
					"name": "Logout",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"// Clear tokens from environment after logout",
									"if (pm.response.code === 200) {",
									"    pm.environment.set('accessToken', '');",
									"    pm.environment.set('refreshToken', '');",
									"    console.log('Tokens cleared from environment');",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
							"raw": "{{baseUrl}}/rest/logout",
							"host": [
								"{{baseUrl}}"
							],
							"path": [
								"rest",
								"logout"
							]
						},
						"description": "Logs out the current user and clears tokens from environment"
					},
					"response": []
				},
				{
					"name": "Refresh token",
					"event": [
						{
							"listen": "test",
							"script": {
								"type": "text/javascript",
								"exec": [
									"// Update tokens in environment after refresh",
									"if (pm.response.code === 200) {",
									"    const response = pm.response.json();",
									"    if (response.accessToken) {",
									"        pm.environment.set('accessToken', response.accessToken);",
									"        console.log('Access token refreshed');",
									"    }",
									"    if (response.refreshToken) {",
									"        pm.environment.set('refreshToken', response.refreshToken);",
									"    }",
									"}"
								]
							}
						}
					],
					"request": {
						"method": "POST",
						"header": [
							{
								"key": "Accept",
								"value": "application/json"
							}
						],
						"url": {
