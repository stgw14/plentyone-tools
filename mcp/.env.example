# plentyONE MCP Server Configuration
# Copy this file to .env and fill in your values

# Base URL of your plentyONE system
# Example: https://your-shop.plentymarkets-cloud01.com
PLENTYONE_BASE_URL=

# plentyONE API user credentials
# Create a dedicated REST API user in plentyONE backend:
# Settings > General > Users > Accounts
PLENTYONE_USERNAME=
PLENTYONE_PASSWORD=
